package main

import "strconv"

templ modifyView(p modifyPage) {
	@layout("Modify "+p.Scope.Title(), "Library") {
		@pageHeader("Modify "+count(p.Count, p.Scope), "") {
		}
		<p>
			Matching <code>{ p.Query }</code>
		</p>
		if p.Count == 0 {
			<div class="alert alert-warning">The query matches no { p.Scope.Title() }.</div>
		}
		<form method="post" action="/modifications" class="card card-body">
			<input type="hidden" name="scope" value={ string(p.Scope) }/>
			<input type="hidden" name="query" value={ p.Query }/>
			<h2 class="h6">Set fields</h2>
			<p class="small text-body-secondary mb-2">
				Values may be beets templates, worked out per { p.Scope.One() }: <code>$title (Remastered)</code>. Separate several values for a list field such as <code>genres</code> with <code>; </code>.
				if p.Scope == albums {
					Album fields are copied down to each Album's Items.
				}
			</p>
			@setRows(p.Scope, 5)
			<h2 class="h6 mt-3">Delete fields</h2>
			<input class="form-control form-control-sm font-monospace mb-3" name="delete_fields" placeholder="field names, separated by spaces or commas" aria-label="Fields to delete"/>
			<div class="d-flex gap-2">
				<button class="btn btn-primary" disabled?={ p.Count == 0 }><i class="bi bi-eye" aria-hidden="true"></i> Preview changes</button>
				<a href="javascript:history.back()" class="btn btn-outline-secondary">Cancel</a>
			</div>
		</form>
	}
}

templ modificationView(m modification) {
	@layout("Modification", "Modifications") {
		@pageHeader("Modification", msTime(m.CreatedAt)) {
		}
		<div
			id="modification"
			if inProgress(m.Status) {
				hx-get={ "/modifications/" + string(m.ID) }
				hx-trigger="every 1s"
				hx-select="#modification"
				hx-swap="outerHTML"
			}
		>
			@requestSummary(m)
			@outcome(m)
			@preview(m)
		</div>
	}
}

templ requestSummary(m modification) {
	<div class="card mb-3">
		<div class="card-body">
			<div class="d-flex flex-wrap gap-2 align-items-center mb-2">
				<span class={ "badge", statusClass(m.Status) }>{ statusText(m.Status) }</span>
				<span>{ modScope(m.Request).Title() } matching <code>{ m.Request.Query }</code></span>
			</div>
			<dl class="row mb-0 small">
				if len(m.Request.Set) > 0 {
					<dt class="col-sm-2">Set</dt>
					<dd class="col-sm-10">
						for _, k := range sortedKeys(m.Request.Set) {
							<div><code>{ k }={ m.Request.Set[k] }</code></div>
						}
					</dd>
				}
				if len(m.Request.Delete) > 0 {
					<dt class="col-sm-2">Delete</dt>
					<dd class="col-sm-10">
						for _, k := range m.Request.Delete {
							<code class="me-2">{ k }</code>
						}
					</dd>
				}
				<dt class="col-sm-2">Files</dt>
				<dd class="col-sm-10">
					if m.Result.Write {
						Tags are written to files.
					} else {
						Only the database changes; tags in files are left alone.
					}
					if m.Result.Move {
						Files move to match their new paths.
					}
				</dd>
			</dl>
		</div>
	</div>
}

templ outcome(m modification) {
	switch m.Status {
		case "previewing":
			<div class="alert alert-info d-flex align-items-center gap-2">
				<div class="spinner-border spinner-border-sm" role="status"></div>
				Building the Preview…
			</div>
		case "failed":
			<div class="alert alert-danger">
				The Preview failed: { orDash(m.Result.Error) }
				<form method="post" action={ templ.URL("/modifications/" + string(m.ID) + "/again") } class="mt-2">
					<button class="btn btn-primary"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Preview again</button>
				</form>
			</div>
		case "awaiting_confirmation":
			<form method="post" action={ templ.URL("/modifications/" + string(m.ID) + "/confirm") } class="d-flex flex-wrap gap-2 align-items-center mb-3">
				<button class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Confirm { previewCount(m) }</button>
				<a href="javascript:history.back()" class="btn btn-outline-secondary">Cancel</a>
				<span class="small text-body-secondary">Nothing changes until you Confirm.</span>
			</form>
		case "no_changes":
			<div class="alert alert-info">Nothing would change: every match already has these values.</div>
		case "queued":
			<div class="alert alert-info">Queued behind another Modification…</div>
		case "applying":
			<div class="alert alert-info">
				Applying… { strconv.Itoa(len(m.Result.Applied)+len(m.Result.Failed)) } of { strconv.Itoa(len(m.Result.Preview.Albums)+len(m.Result.Preview.Items)) } done.
				<div class="progress mt-2" role="progressbar" aria-label="Progress">
					<div class="progress-bar" style={ progressStyle(m) }></div>
				</div>
			</div>
		case "applied":
			<div class="alert alert-success">Applied to { records(len(m.Result.Applied)) }.</div>
		case "partial":
			<div class="alert alert-danger">
				Applied to { records(len(m.Result.Applied)) }; { strconv.Itoa(len(m.Result.Failed)) } failed.
				if m.Result.Error != "" {
					<div class="small">{ m.Result.Error }</div>
				}
				<ul class="mb-0 mt-2 small">
					for _, f := range m.Result.Failed {
						<li><a href={ templ.URL(recordURL(scope(f.Scope), f.ID)) }>{ scope(f.Scope).One() } { strconv.Itoa(f.ID) }</a>: { f.Error }</li>
					}
				</ul>
			</div>
		case "rejected":
			<div class="alert alert-warning">
				The Library changed after this Preview, so nothing was applied. Changed since:
				<ul class="small mt-2">
					for _, s := range m.Result.Stale {
						<li><a href={ templ.URL(recordURL(scope(s.Scope), s.ID)) }>{ scope(s.Scope).One() } { strconv.Itoa(s.ID) }</a></li>
					}
				</ul>
				<form method="post" action={ templ.URL("/modifications/" + string(m.ID) + "/again") }>
					<button class="btn btn-primary"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Preview again</button>
				</form>
			</div>
		case "interrupted":
			<div class="alert alert-warning">
				if len(m.Result.Preview.Albums)+len(m.Result.Preview.Items) == 0 {
					beets-api restarted before the Preview was ready.
				} else {
					beets-api restarted while this was running. { records(len(m.Result.Applied)) } had been applied.
				}
				<form method="post" action={ templ.URL("/modifications/" + string(m.ID) + "/again") } class="mt-2">
					<button class="btn btn-primary"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Preview again</button>
				</form>
			</div>
	}
}

func records(n int) string {
	if n == 1 {
		return "1 record"
	}
	return strconv.Itoa(n) + " records"
}

func previewCount(m modification) string {
	a, i := len(m.Result.Preview.Albums), len(m.Result.Preview.Items)
	switch {
	case a > 0 && i > 0:
		return count(a, albums) + " and " + count(i, items)
	case a > 0:
		return count(a, albums)
	default:
		return count(i, items)
	}
}

func progressStyle(m modification) string {
	total := len(m.Result.Preview.Albums) + len(m.Result.Preview.Items)
	if total == 0 {
		return "width: 0%"
	}
	done := len(m.Result.Applied) + len(m.Result.Failed)
	return "width: " + strconv.Itoa(done*100/total) + "%"
}

templ preview(m modification) {
	for _, section := range []struct{ Scope scope; Entries []previewEntry }{{albums, m.Result.Preview.Albums}, {items, m.Result.Preview.Items}} {
		if len(section.Entries) > 0 {
			<h2 class="h4 mt-3">Preview: { count(len(section.Entries), section.Scope) }</h2>
			for _, e := range capped(section.Entries) {
				<div class="card mb-2">
					<div class="card-header py-1"><a href={ templ.URL(recordURL(section.Scope, e.ID)) }>{ e.Label }</a></div>
					<table class="table table-sm mb-0 preview-table">
						<tbody>
							for _, field := range sortedKeys(e.Changes) {
								<tr>
									<td class="font-monospace small field-col">{ field }</td>
									<td class="old text-break"><del>{ valueString(e.Changes[field].Old) }</del></td>
									<td class="new text-break"><ins>{ valueString(e.Changes[field].New) }</ins></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			if len(section.Entries) > previewLimit {
				<p class="text-body-secondary">…and { strconv.Itoa(len(section.Entries) - previewLimit) } more { section.Scope.Title() }.</p>
			}
		}
	}
}

templ modificationsView(p modificationsPage) {
	@layout("Modifications", "Modifications") {
		@pageHeader("Modifications", "Every Modification, newest first. The Audit shows what each one changed.") {
		}
		if len(p.Mods) == 0 {
			<p class="text-body-secondary">No Modifications yet.</p>
		} else {
			<table class="table table-sm table-hover align-middle">
				<thead>
					<tr><th>When</th><th>Status</th><th>Query</th><th>Changes</th></tr>
				</thead>
				<tbody>
					for _, m := range p.Mods {
						<tr>
							<td class="small"><a href={ templ.URL("/modifications/" + string(m.ID)) }>{ msTime(m.CreatedAt) }</a></td>
							<td><span class={ "badge", statusClass(m.Status) }>{ statusText(m.Status) }</span></td>
							<td>{ modScope(m.Request).Title() } <code>{ m.Request.Query }</code></td>
							<td class="small">
								for _, k := range sortedKeys(m.Request.Set) {
									<code class="me-2">{ k }={ m.Request.Set[k] }</code>
								}
								for _, k := range m.Request.Delete {
									<code class="me-2">{ k }!</code>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			<div class="d-flex gap-2">
				if p.Offset > 0 {
					<a class="btn btn-sm btn-outline-secondary" href={ templ.URL("/modifications?offset=" + strconv.Itoa(max(0, p.Offset-50))) }><i class="bi bi-chevron-left" aria-hidden="true"></i> Newer</a>
				}
				if p.Offset+len(p.Mods) < p.Total {
					<a class="btn btn-sm btn-outline-secondary" href={ templ.URL("/modifications?offset=" + strconv.Itoa(p.Offset+50)) }>Older <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
				}
			</div>
		}
	}
}
