package main

import "strconv"

templ artistsView(p artistsPage) {
	@layout("Artists", "Artists") {
		@pageHeader("Artists", artistsSubtitle(p)) {
		}
		if p.Unavailable {
			<div class="alert alert-warning">
				This beets-api has no <code>GET /artists</code> yet, so there's no Artist list. Browse <a href="/albums">Albums</a> or <a href="/items">Items</a> instead; Artist pages still work from their links.
			</div>
		} else {
			<input
				class="form-control mb-3 artist-search"
				type="search"
				name="q"
				value={ p.Query }
				placeholder="Find an Artist"
				aria-label="Find an Artist"
				autofocus
				hx-get="/artists"
				hx-trigger="input changed delay:250ms, search"
				hx-target="#artist-list"
				hx-select="#artist-list"
				hx-swap="outerHTML"
				hx-push-url="true"
			/>
			<div id="artist-list" class="list-group list-group-flush">
				for _, a := range p.Artists {
					<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href={ templ.URL(artistURL(a.Name, "")) }>
						<span>{ a.Name }</span>
						<span class="small text-body-secondary">{ artistCounts(a) }</span>
					</a>
				}
				if len(p.Artists) == 0 {
					<p class="text-body-secondary">No Artists match.</p>
				}
			</div>
		}
	}
}

func artistsSubtitle(p artistsPage) string {
	if p.Unavailable {
		return ""
	}
	if p.Query != "" {
		return strconv.Itoa(p.Total) + " matching"
	}
	return strconv.Itoa(p.Total) + " Artists"
}

func artistCounts(a artistSummary) string {
	s := ""
	if a.AlbumCount > 0 {
		s = count(a.AlbumCount, albums)
	}
	if a.ItemCount > 0 {
		if s != "" {
			s += " · "
		}
		s += count(a.ItemCount, items)
	}
	return s
}

templ artistView(p artistPage) {
	@layout(p.Name, "Artists") {
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				<li class="breadcrumb-item"><a href="/artists">Artists</a></li>
				<li class="breadcrumb-item active" aria-current="page">{ p.Name }</li>
			</ol>
		</nav>
		@pageHeader(p.Name, count(p.Counts[albums], albums)+" · "+count(p.Counts[items], items)) {
		}
		<ul class="nav nav-tabs mb-3">
			for _, k := range []scope{albums, items} {
				<li class="nav-item">
					if k == p.Tab {
						<a class="nav-link active" aria-current="page" href={ templ.URL(artistURL(p.Name, k)) }>{ k.Title() } <span class="badge text-bg-secondary">{ strconv.Itoa(p.Counts[k]) }</span></a>
					} else {
						<a class="nav-link" href={ templ.URL(artistURL(p.Name, k)) }>{ k.Title() } <span class="badge text-bg-secondary">{ strconv.Itoa(p.Counts[k]) }</span></a>
					}
				</li>
			}
		</ul>
		@recordTable(p.Table)
	}
}

templ listView(p listPage) {
	@layout(p.Scope.Title(), p.Scope.Title()) {
		@pageHeader(p.Scope.Title(), listSubtitle(p)) {
		}
		@filterForm(p)
		if p.Error != "" {
			<div class="alert alert-danger" role="alert">{ p.Error }</div>
		} else {
			@recordTable(p.Table)
		}
	}
}

func listSubtitle(p listPage) string {
	if p.Error != "" {
		return ""
	}
	return count(p.Table.Total, p.Scope)
}

templ filterForm(p listPage) {
	<form method="get" action={ templ.URL("/" + string(p.Scope)) } class="card card-body mb-3">
		<div class="row g-2">
			<div class="col-12">
				<label class="form-label small mb-1" for="q">beets query</label>
				<input class="form-control font-monospace" id="q" name="q" value={ p.Filters.Query } placeholder="artist:Beatles year:1960..1969"/>
			</div>
			<div class="col-6 col-md-2">
				<label class="form-label small mb-1" for="year_from">Year from</label>
				<input class="form-control" id="year_from" name="year_from" inputmode="numeric" value={ p.Filters.YearFrom }/>
			</div>
			<div class="col-6 col-md-2">
				<label class="form-label small mb-1" for="year_to">Year to</label>
				<input class="form-control" id="year_to" name="year_to" inputmode="numeric" value={ p.Filters.YearTo }/>
			</div>
			<div class="col-6 col-md-2">
				<label class="form-label small mb-1" for="genre">Genre</label>
				<input class="form-control" id="genre" name="genre" value={ p.Filters.Genre }/>
			</div>
			<div class="col-6 col-md-2">
				<label class="form-label small mb-1" for="albumtype">Album type</label>
				<input class="form-control" id="albumtype" name="albumtype" list="albumtypes" value={ p.Filters.AlbumType }/>
				<datalist id="albumtypes">
					<option value="album"></option>
					<option value="single"></option>
					<option value="ep"></option>
					<option value="compilation"></option>
					<option value="live"></option>
					<option value="soundtrack"></option>
				</datalist>
			</div>
			<div class="col-6 col-md-2">
				<label class="form-label small mb-1" for="format">Format</label>
				<input class="form-control" id="format" name="format" list="formats" value={ p.Filters.Format }/>
				<datalist id="formats">
					<option value="FLAC"></option>
					<option value="MP3"></option>
					<option value="AAC"></option>
					<option value="ALAC"></option>
					<option value="OGG"></option>
					<option value="Opus"></option>
				</datalist>
			</div>
			<div class="col-6 col-md-2 d-flex align-items-end">
				<div class="form-check mb-2">
					<input class="form-check-input" type="checkbox" id="order" name="order" value="recent" checked?={ p.Filters.Recent }/>
					<label class="form-check-label" for="order">Recently added</label>
				</div>
			</div>
		</div>
		<div class="d-flex flex-wrap align-items-center gap-2 mt-3">
			<button class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
			<a class="btn btn-outline-secondary" href={ templ.URL("/" + string(p.Scope)) }>Clear</a>
			if p.Filters.Active() {
				<span class="small text-body-secondary">Query:</span>
				<code class="small">{ p.Filters.Combined() }</code>
				<a class="small" href={ templ.URL(listURL(p.Scope, filters{Query: p.Filters.Combined()}, p.Filters.Recent)) }>edit as query</a>
			}
		</div>
	</form>
}

// homeView is the home page: a search bar, then the recently added Albums.
templ homeView(recent []record) {
	@layout("Search", "Home") {
		<form method="get" action="/search" role="search" class="home-search mx-auto">
			<input class="form-control form-control-lg font-monospace" type="search" name="q" placeholder="Search the Library" aria-label="Search the Library" autofocus/>
		</form>
		if len(recent) > 0 {
			<section class="home-recent mx-auto mt-5">
				<div class="d-flex justify-content-between align-items-baseline mb-2">
					<h2 class="h5">Recently added</h2>
					<a class="small" href={ templ.URL(listURL(albums, filters{}, true)) }>See all Albums</a>
				</div>
				<div class="row row-cols-3 row-cols-md-4 row-cols-lg-6 g-3">
					for _, a := range recent {
						<div class="col">
							<a class="d-block text-decoration-none" href={ templ.URL(recordURL(albums, a.ID())) }>
								<img class="recent-art rounded border w-100" src={ "/albums/" + strconv.Itoa(a.ID()) + "/art" } alt="" loading="lazy" onerror="this.style.visibility='hidden'"/>
								<div class="small fw-semibold text-truncate mt-1">{ orDash(a.Str("album")) }</div>
								<div class="small text-body-secondary text-truncate">{ a.Str("albumartist") }</div>
							</a>
						</div>
					}
				</div>
			</section>
		}
	}
}

templ searchView(p searchPage) {
	@layout("Search", "") {
		@pageHeader("Search", "") {
		}
		<form method="get" action="/search" class="mb-3">
			<div class="input-group">
				<input class="form-control font-monospace" name="q" value={ p.Query } placeholder="beets query, e.g. love year:1960..1969" aria-label="beets query" autofocus/>
				<button class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
			</div>
		</form>
		if p.Error != "" {
			<div class="alert alert-danger" role="alert">{ p.Error }</div>
		} else if p.Query != "" {
			for _, k := range []scope{albums, items} {
				<section class="mb-4">
					<div class="d-flex justify-content-between align-items-baseline">
						<h2 class="h4">{ k.Title() } <span class="badge text-bg-secondary">{ strconv.Itoa(p.Tables[k].Total) }</span></h2>
						if p.Tables[k].Total > len(p.Tables[k].Rows) {
							<a href={ templ.URL(listURL(k, filters{Query: p.Query}, false)) }>See all { count(p.Tables[k].Total, k) }</a>
						}
					</div>
					@recordTable(p.Tables[k])
				</section>
			}
		}
	}
}

// recordTable lists Albums or Items with checkboxes, so ticked rows or
// everything the query matches can be Modified.
templ recordTable(t tableData) {
	if t.Total == 0 {
		<p class="text-body-secondary">No { t.Scope.Title() } match.</p>
	} else {
		if t.Query != "" {
			<form id={ "remove-all-" + string(t.Scope) } method="post" action="/removals">
				<input type="hidden" name="scope" value={ string(t.Scope) }/>
				<input type="hidden" name="q" value={ t.Query }/>
			</form>
		}
		<form method="get" action="/modify" class="record-table">
			<input type="hidden" name="scope" value={ string(t.Scope) }/>
			<div class="d-flex flex-wrap gap-2 mb-2">
				<button class="btn btn-sm btn-outline-primary" type="submit"><i class="bi bi-pencil" aria-hidden="true"></i> Modify selected</button>
				<a class="btn btn-sm btn-outline-primary" href={ templ.URL(t.ModifyAllURL()) }><i class="bi bi-pencil" aria-hidden="true"></i> Modify all { count(t.Total, t.Scope) }</a>
				<button class="btn btn-sm btn-outline-danger ms-md-3" type="submit" formaction="/removals" formmethod="post"><i class="bi bi-trash" aria-hidden="true"></i> Remove selected</button>
				if t.Query != "" {
					<button class="btn btn-sm btn-outline-danger" type="submit" form={ "remove-all-" + string(t.Scope) }><i class="bi bi-trash" aria-hidden="true"></i> Remove all { count(t.Total, t.Scope) }</button>
				}
			</div>
			<div class="table-responsive">
				<table class="table table-sm table-hover align-middle">
					<thead>
						<tr>
							<th class="select-col"><input class="form-check-input" type="checkbox" aria-label="Select all shown" data-select-all/></th>
							if t.Scope == albums {
								<th>Album</th>
								<th>Album artist</th>
								<th>Year</th>
								<th>Type</th>
							} else {
								<th>Title</th>
								<th>Artist</th>
								<th>Album</th>
								<th class="text-end">#</th>
								<th class="text-end">Length</th>
								<th>Year</th>
							}
						</tr>
					</thead>
					<tbody>
						@tableRows(t)
					</tbody>
				</table>
			</div>
		</form>
		<script>
			document.querySelectorAll('[data-select-all]').forEach(function (box) {
				box.onchange = function () {
					box.closest('table').querySelectorAll('tbody input[name=id]').forEach(function (b) { b.checked = box.checked; });
				};
			});
		</script>
	}
}

// tableRows are one batch of rows, ending with a row that loads the next batch
// when scrolled into view.
templ tableRows(t tableData) {
	for _, r := range t.Rows {
		<tr>
			<td class="select-col"><input class="form-check-input" type="checkbox" name="id" value={ strconv.Itoa(r.ID()) } aria-label="Select"/></td>
			if t.Scope == albums {
				<td><a href={ templ.URL(recordURL(albums, r.ID())) }>{ orDash(r.Str("album")) }</a></td>
				<td>
					@artistLinks(r.Str("albumartist"), t.Separators)
				</td>
				<td>{ yearText(r) }</td>
				<td>{ r.Str("albumtype") }</td>
			} else {
				<td><a href={ templ.URL(recordURL(items, r.ID())) }>{ orDash(r.Str("title")) }</a></td>
				<td>
					@artistLinks(r.Str("artist"), t.Separators)
				</td>
				<td>
					if id := r.Int("album_id"); id != 0 {
						<a href={ templ.URL(recordURL(albums, id)) }>{ orDash(r.Str("album")) }</a>
					} else {
						<span class="text-body-secondary">Singleton</span>
					}
				</td>
				<td class="text-end">{ trackNumber(r) }</td>
				<td class="text-end">{ duration(r) }</td>
				<td>{ yearText(r) }</td>
			}
		</tr>
	}
	if t.Next != "" {
		<tr hx-get={ t.Next } hx-trigger="revealed" hx-swap="outerHTML">
			<td colspan="7" class="text-center text-body-secondary small">Loading more…</td>
		</tr>
	}
}
