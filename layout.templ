package main

import "strconv"

templ layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>{ title } · beets</title>
			<script src={ assetURL("theme.js") }></script>
			<link rel="stylesheet" href={ assetURL("bootstrap.min.css") }/>
			<link rel="stylesheet" href={ assetURL("bootstrap-icons.min.css") }/>
			<link rel="stylesheet" href={ assetURL("app.css") }/>
		</head>
		<body>
			<nav class="navbar navbar-expand-md border-bottom">
				<div class="container-xl">
					<a class="navbar-brand" href="/">beets</a>
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
					<div class="collapse navbar-collapse" id="main-nav">
						<ul class="navbar-nav me-auto">
							@navLink("/albums", "disc", "Albums", active)
							@navLink("/items", "music-note", "Items", active)
							@navLink("/import", "box-arrow-in-down", "Import", active)
						</ul>
						if active != "Home" {
							<form class="d-flex me-md-2 my-2 my-md-0" role="search" method="get" action="/search">
								<input class="form-control form-control-sm" type="search" name="q" placeholder="Search the Library" aria-label="Search the Library"/>
							</form>
						}
						<ul class="navbar-nav">
							{{ who := currentUser(ctx) }}
							<li class="nav-item dropdown">
								<a class={ "nav-link dropdown-toggle", templ.KV("active", userMenuActive(active)) } href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-circle" aria-hidden="true"></i> { who.DisplayName() }</a>
								<ul class="dropdown-menu dropdown-menu-end">
									@menuLink("/profile", "person-vcard", "Profile", active)
									@menuLink("/modifications", "pencil-square", "Modifications", active)
									@menuLink("/audit", "journal-text", "Audit", active)
								</ul>
							</li>
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-circle-half" aria-hidden="true"></i> Theme</a>
								<ul class="dropdown-menu dropdown-menu-end">
									<li><button class="dropdown-item" type="button" data-theme-choice="auto"><i class="bi bi-circle-half" aria-hidden="true"></i> Auto</button></li>
									<li><button class="dropdown-item" type="button" data-theme-choice="light"><i class="bi bi-sun" aria-hidden="true"></i> Light</button></li>
									<li><button class="dropdown-item" type="button" data-theme-choice="dark"><i class="bi bi-moon-stars" aria-hidden="true"></i> Dark</button></li>
								</ul>
							</li>
						</ul>
					</div>
				</div>
			</nav>
			<main class="container-xl py-3">
				{ children... }
			</main>
			<script src={ assetURL("bootstrap.bundle.min.js") }></script>
			<script src={ assetURL("htmx.min.js") }></script>
		</body>
	</html>
}

templ navLink(href, iconName, label, active string) {
	<li class="nav-item">
		if label == active {
			<a class="nav-link active" aria-current="page" href={ templ.URL(href) }>
				@icon(iconName)
				{ label }
			</a>
		} else {
			<a class="nav-link" href={ templ.URL(href) }>
				@icon(iconName)
				{ label }
			</a>
		}
	</li>
}

// userMenuActive tells whether the page is one the person's menu holds.
func userMenuActive(active string) bool {
	return active == "Profile" || active == "Modifications" || active == "Audit"
}

templ menuLink(href, iconName, label, active string) {
	<li>
		if label == active {
			<a class="dropdown-item active" aria-current="page" href={ templ.URL(href) }>
				@icon(iconName)
				{ label }
			</a>
		} else {
			<a class="dropdown-item" href={ templ.URL(href) }>
				@icon(iconName)
				{ label }
			</a>
		}
	</li>
}

templ pageHeader(title string, subtitle string) {
	<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
		<div>
			<h1 class="h2 mb-0">{ title }</h1>
			if subtitle != "" {
				<div class="text-body-secondary">{ subtitle }</div>
			}
		</div>
		<div class="d-flex flex-wrap gap-2">
			{ children... }
		</div>
	</div>
}

templ errorPage(status int, msg string) {
	@layout("Error", "") {
		@pageHeader("Something went wrong", strconv.Itoa(status)) {
		}
		<div class="alert alert-danger" role="alert">{ msg }</div>
		<a href="javascript:history.back()" class="btn btn-outline-secondary">Back</a>
	}
}

// artistLinks links each Artist a credit names, keeping the credit's own text
// between them.
templ artistLinks(credit string, separators []string) {
	if names := splitArtists(credit, separators); len(names) == 1 {
		<a href={ templ.URL(artistURL(names[0], "")) }>{ credit }</a>
	} else if len(names) == 0 {
		<span class="text-body-secondary">—</span>
	} else {
		for i, name := range names {
			if i > 0 {
				<span class="text-body-secondary">·</span>
			}
			<a href={ templ.URL(artistURL(name, "")) }>{ name }</a>
		}
	}
}

// icon is a decorative Bootstrap Icon; the text beside it carries the meaning.
templ icon(name string) {
	<i class={ "bi", "bi-" + name } aria-hidden="true"></i>
}
