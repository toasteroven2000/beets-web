package main

import "strconv"

func artURL(id int) string { return "/albums/" + strconv.Itoa(id) + "/art" }

// artTab shows an Album's art beside the ways to Set art: search iTunes and
// Deezer, enter a URL, or upload a file, one at a time.
templ artTab(p recordPage) {
	{{ id := p.Record.ID() }}
	if p.ArtNotice != "" {
		<div class="alert alert-success" role="status">{ p.ArtNotice }</div>
	}
	if p.ArtError != "" {
		<div class="alert alert-danger" role="alert">{ p.ArtError }</div>
	}
	<div class="row g-4">
		<div class="col-md-4 col-lg-3">
			<div class="sticky-md-top art-current">
				<h2 class="visually-hidden">Current art</h2>
				if p.Art.Exists {
					<a href={ templ.URL(artURL(id)) } target="_blank" rel="noopener">
						<img class="img-fluid rounded border" src={ artURL(id) } alt={ "Art for " + recordTitle(p) }/>
					</a>
					<div class="small text-body-secondary mt-1">
						{ p.Art.Dims() } · <a href={ templ.URL(artURL(id)) } target="_blank" rel="noopener">Full size <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
					</div>
					<div class="small text-body-secondary font-monospace text-break">{ p.Record.Str("artpath") }</div>
					<a class="btn btn-sm btn-outline-danger mt-2" href={ templ.URL(artURL(id) + "/remove") }><i class="bi bi-trash" aria-hidden="true"></i> Remove art</a>
				} else {
					<div class="art-none rounded border d-flex align-items-center justify-content-center text-body-secondary">No art</div>
				}
			</div>
		</div>
		<div class="col-md-8 col-lg-9">
			<ul class="nav nav-pills mb-3" role="tablist">
				@artPill("search", "Search", p.ArtPane)
				@artPill("url", "URL", p.ArtPane)
				@artPill("file", "File", p.ArtPane)
			</ul>
			<div class="tab-content">
				<div class={ "tab-pane", templ.KV("show active", p.ArtPane == "search") } id="art-search" role="tabpanel">
					<form class="d-flex gap-2 mb-1" hx-get={ artURL(id) + "/search" } hx-target="#art-results" hx-trigger="submit" hx-indicator="#art-loading">
						<input class="form-control" type="search" name="q" value={ p.ArtQuery } aria-label="Search for the Album"/>
						<button class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
					</form>
					<div class="form-text mb-3">Searches iTunes and Deezer. The closest matches to this Album come first; green marks a track count or year that matches.</div>
					<div id="art-loading" class="htmx-indicator text-body-secondary small mb-2">
						<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Searching…
					</div>
					<div id="art-results"></div>
				</div>
				<div class={ "tab-pane", templ.KV("show active", p.ArtPane == "url") } id="art-url" role="tabpanel">
					<form method="post" action={ templ.SafeURL(artURL(id)) } class="d-flex gap-2">
						<input class="form-control" type="url" name="url" value={ p.ArtURL } placeholder="https://… (JPEG or PNG)" aria-label="Image URL" required/>
						<button class="btn btn-primary text-nowrap"><i class="bi bi-image" aria-hidden="true"></i> Set art</button>
					</form>
				</div>
				<div class={ "tab-pane", templ.KV("show active", p.ArtPane == "file") } id="art-file" role="tabpanel">
					<form method="post" action={ templ.SafeURL(artURL(id)) } enctype="multipart/form-data" class="d-flex gap-2">
						<input class="form-control" type="file" name="file" accept="image/jpeg,image/png" aria-label="Image file" required/>
						<button class="btn btn-primary text-nowrap"><i class="bi bi-image" aria-hidden="true"></i> Set art</button>
					</form>
				</div>
			</div>
		</div>
	</div>
}

templ artPill(pane, label, active string) {
	<li class="nav-item" role="presentation">
		<button class={ "nav-link", templ.KV("active", pane == active) } type="button" data-bs-toggle="pill" data-bs-target={ "#art-" + pane } role="tab">{ label }</button>
	</li>
}

// artResults are the candidates a search found, closest match first.
templ artResults(id int, found []artCandidate, problems []string) {
	for _, p := range problems {
		<div class="small text-body-secondary mb-1">{ p }</div>
	}
	<div class="row g-3">
		for _, c := range found {
			<div class="col-6 col-lg-4 col-xl-3">
				<div class="card h-100">
					<a href={ templ.URL(c.Full) } target="_blank" rel="noopener">
						<img class="card-img-top" src={ c.Thumb } alt={ c.Label } loading="lazy"/>
					</a>
					<div class="card-body p-2 small d-flex flex-column">
						<div class="text-truncate" title={ c.Label }>{ c.Label }</div>
						<div class="text-body-secondary">
							if c.Tracks != 0 {
								<span class={ templ.KV("text-success", c.TracksMatch) }>{ strconv.Itoa(c.Tracks) } tracks</span>
							}
							if c.Tracks != 0 && c.Year != 0 {
								·
							}
							if c.Year != 0 {
								<span class={ templ.KV("text-success", c.YearMatch) }>{ strconv.Itoa(c.Year) }</span>
							}
						</div>
						<div class="text-body-secondary mb-2">
							if c.Page != "" {
								<a href={ templ.URL(c.Page) } target="_blank" rel="noopener">{ c.Source }</a>
							} else {
								{ c.Source }
							}
							· <a href={ templ.URL(c.Full) } target="_blank" rel="noopener">{ c.Dims() }</a>
						</div>
						<form method="post" action={ templ.SafeURL(artURL(id)) } class="mt-auto">
							<input type="hidden" name="url" value={ c.Full }/>
							<input type="hidden" name="candidate" value="1"/>
							<button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-image" aria-hidden="true"></i> Set art</button>
						</form>
					</div>
				</div>
			</div>
		}
	</div>
}

// artCompareView shows the current art beside its replacement before Set art,
// because setting it deletes the current file.
templ artCompareView(p artComparePage) {
	{{ id := p.Album.ID() }}
	{{ title := orDash(p.Album.Str("album")) }}
	@layout("Set art · "+title, "Albums") {
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				<li class="breadcrumb-item"><a href="/albums">Albums</a></li>
				<li class="breadcrumb-item"><a href={ templ.URL(recordTabURL(albums, id, "art")) }>{ title }</a></li>
				<li class="breadcrumb-item active" aria-current="page">Set art</li>
			</ol>
		</nav>
		@pageHeader("Replace the art of "+title, "beets-api moves the current art to the Trash before replacing it.") {
		}
		<div class="row g-4 mb-4">
			<div class="col-md-6">
				<h2 class="h5">Current</h2>
				<a href={ templ.URL(artURL(id)) } target="_blank" rel="noopener">
					<img class="img-fluid rounded border art-compare" src={ artURL(id) } alt="Current art"/>
				</a>
				<div class="small text-body-secondary mt-1">
					{ p.Current.Dims() } · <a href={ templ.URL(artURL(id)) } target="_blank" rel="noopener">Full size <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
				</div>
			</div>
			<div class="col-md-6">
				{{ img := artURL(id) + "/new/" + p.Token + "/image" }}
				<h2 class="h5">New</h2>
				<a href={ templ.URL(img) } target="_blank" rel="noopener">
					<img class="img-fluid rounded border art-compare" src={ img } alt="New art"/>
				</a>
				<div class="small text-body-secondary mt-1">
					{ p.New.Dims() } · <a href={ templ.URL(img) } target="_blank" rel="noopener">Full size <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
				</div>
				<div class="small text-body-secondary text-break">{ p.Source }</div>
			</div>
		</div>
		<form method="post" action={ templ.SafeURL(artURL(id) + "/new/" + p.Token) } class="d-flex gap-2">
			<button class="btn btn-primary"><i class="bi bi-image" aria-hidden="true"></i> Set art</button>
			<a class="btn btn-outline-secondary" href={ templ.URL(recordTabURL(albums, id, "art")) }>Cancel</a>
		</form>
	}
}

// artRemoveView asks before Remove art.
templ artRemoveView(album record, current artInfo) {
	{{ id := album.ID() }}
	{{ title := orDash(album.Str("album")) }}
	@layout("Remove art · "+title, "Albums") {
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				<li class="breadcrumb-item"><a href="/albums">Albums</a></li>
				<li class="breadcrumb-item"><a href={ templ.URL(recordTabURL(albums, id, "art")) }>{ title }</a></li>
				<li class="breadcrumb-item active" aria-current="page">Remove art</li>
			</ol>
		</nav>
		@pageHeader("Remove the art of "+title+"?", "beets-api moves the image to the Trash, where it stays until the Trash is purged. The UI can't put it back.") {
		}
		<div class="mb-4 art-remove">
			<a href={ templ.URL(artURL(id)) } target="_blank" rel="noopener">
				<img class="img-fluid rounded border" src={ artURL(id) } alt="Current art"/>
			</a>
			<div class="small text-body-secondary mt-1">
				{ current.Dims() } · <a href={ templ.URL(artURL(id)) } target="_blank" rel="noopener">Full size <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
			</div>
			<div class="small text-body-secondary font-monospace text-break">{ album.Str("artpath") }</div>
		</div>
		<form method="post" action={ templ.SafeURL(artURL(id) + "/remove") } class="d-flex gap-2">
			<button class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i> Remove art</button>
			<a class="btn btn-outline-secondary" href={ templ.URL(recordTabURL(albums, id, "art")) }>Cancel</a>
		</form>
	}
}
